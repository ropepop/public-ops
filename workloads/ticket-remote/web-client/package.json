{
  "name": "ticket-remote-web-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs && node ./build-ticket-app.mjs",
    "build:ticket-app": "node ./build-ticket-app.mjs",
    "test:experimental-hdr-preference": "node --test ./experimental-hdr-preference.test.mjs",
    "test:client-hdr-boost-preference": "node --test ./client-hdr-boost-preference.test.mjs",
    "test:client-hdr": "node --test ./client-hdr-core.test.mjs ./client-hdr-renderer.test.mjs ./client-hdr-diagnostic.test.mjs",
    "test:client-hdr-real-gpu:serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test:ticket-actions-v3": "node --test ./ticket-action-v3-core.test.mjs",
    "check:spacetime-sdk": "node --test ./check-spacetime-sdk.test.mjs && node ./check-spacetime-sdk.mjs",
    "test:csp-codecs": "node --test ./csp-safe-codecs.test.ts"
  },
  "dependencies": {
    "@arrow-js/core": "1.0.6",
    "spacetimedb": "2.6.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.3",
    "typescript": "~5.6.2"
  }
}
