{
  "$schema": "https://raw.githubusercontent.com/Ylianst/MeshCentral/1.2.5/meshcentral-config-schema.json",
  "settings": {
    "cert": "mesh.jolkins.id.lv",
    "WANonly": true,
    "port": 28443,
    "redirPort": 0,
    "mpsPort": 0,
    "exactPorts": true,
    "tlsOffload": false,
    "selfUpdate": false,
    "webRTC": false,
    "allowFraming": false,
    "allowLoginToken": false,
    "sessionTime": 60,
    "maxInvalidLogin": {
      "time": 10,
      "count": 5,
      "coolofftime": 30
    },
    "maxInvalid2fa": {
      "time": 10,
      "count": 5,
      "coolofftime": 30
    }
  },
  "domains": {
    "": {
      "newAccounts": false,
      "localSessionRecording": true,
      "userSessionIdleTimeout": 30,
      "logoutOnIdleSessionTimeout": true,
      "passwordRequirements": {
        "min": 14,
        "force2factor": false,
        "otp2factor": true,
        "loginTokens": false
      }
    }
  }
}
